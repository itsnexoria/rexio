{
  "name": "rexio",
  "productName": "Rexio",
  "version": "1.0.4",
  "description": "Roblox account manager - add accounts and launch straight into Roblox.",
  "author": {
    "name": "Nexus",
    "email": "support@nexorealm.org"
  },
  "homepage": "https://nexorealm.org/",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux deb",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rexio.app",
    "productName": "Rexio",
    "files": ["src/**/*", "renderer/**/*", "package.json"],
    "linux": {
      "target": ["deb"],
      "category": "Game",
      "icon": "renderer/icon.png",
      "executableName": "rexio"
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils"]
    },
    "win": {
      "target": ["nsis"],
      "icon": "renderer/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "itsnexoria",
      "repo": "rexio"
    }
  }
}
